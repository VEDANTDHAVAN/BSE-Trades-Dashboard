PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bse_trades
MOCK_BSE_DELAY_MS=1000
REDIS_HOST=localhost
REDIS_PORT=6379
MOCK_BSE_URL=http://localhost:4000/mock-bse/getTrades
# Worker-side timeout for the mock BSE request. Must be >= MOCK_BSE_DELAY_MS.
# 16 minutes (960000ms) covers the 15-minute worst-case pull.
MOCK_BSE_TIMEOUT_MS=960000
TRADE_PULL_INTERVAL_MS=900000